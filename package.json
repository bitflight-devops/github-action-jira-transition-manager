{
  "name": "github-action-jira-transition-manager",
  "version": "1.1.6",
  "description": "This action will transition the list of Jira issues provided between states, or it will display the available transitions and the current issue state.",
  "type": "module",
  "main": "dist/index.js",
  "sideEffects": false,
  "displayName": "bitflight-devops/github-action-jira-transition-manager",
  "repository": {
    "type": "git",
    "url": "git@github.com:bitflight-devops/github-action-jira-transition-manager.git"
  },
  "bugs": {
    "url": "https://github.com/bitflight-devops/github-action-jira-transition-manager/issues"
  },
  "keywords": [
    "actions",
    "github",
    "node22",
    "jira",
    "tickets"
  ],
  "author": "Jamie Nelson <jamie@wearsafe.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "NODE_ENV=testing vitest run",
    "test:watch": "NODE_ENV=testing vitest",
    "test-ci": "NODE_ENV=testing vitest run --reporter=default --reporter=junit --outputFile=junit.xml",
    "build": "rimraf dist && yarn package",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:markdown:fix": "yarn lint:markdown --fix",
    "lint:markdown": "markdownlint \"**/*.md\" --config=.markdownlint.json --ignore-path=.markdownlintignore",
    "all": "yarn run build && yarn run format && yarn run lint && yarn run package && yarn test",
    "commit": "git-cz",
    "pre-commit": "lint-staged && yarn run build && git add dist && yarn run generate-docs",
    "preversion": "echo 'Running test';yarn test",
    "version": "yarn generate-docs",
    "postversion": "echo \"Prepared release version $npm_package_version\"",
    "generate-docs": "github-action-readme-generator && biome format --write .ghadocs.json README.md && git add .ghadocs.json README.md",
    "prepare": "test -n \"$CI\" || (husky && git config --global rebase.autosquash true)",
    "pre-push": "echo 'Running pre-push checks'; exit 0",
    "e2e:test": "NODE_ENV=testing vitest run --config vitest.e2e.config.ts",
    "e2e:prepare": "node e2e/jira/harness.mjs init && node e2e/jira/harness.mjs images && npm ci --prefix e2e/jira --ignore-scripts && node e2e/jira/node_modules/playwright/cli.js install --with-deps chromium && node e2e/jira/harness.mjs prepare",
    "e2e:down": "node e2e/jira/harness.mjs down",
    "e2e:logs": "node e2e/jira/harness.mjs logs",
    "e2e:all": "yarn build && yarn e2e:prepare && yarn e2e:test",
    "e2e:fixture:test": "node --test e2e/jira/fixture.test.mjs",
    "e2e:fixture:check": "node e2e/jira/harness.mjs check",
    "e2e:fixture:restore": "node e2e/jira/harness.mjs restore"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-length": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "footer-max-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ],
      "header-max-length": [
        0
      ]
    }
  },
  "engines": {
    "node": ">=24.19.0 <30.0.0"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/rest": "^22.0.1",
    "ansi-colors": "^4.1.3",
    "is-plain-object": "^5.1.0",
    "jira.js": "^5.2.2",
    "lodash": "^4.18.1",
    "tslib": "^2.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@commitlint/prompt": "^21",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.16.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.25",
    "@types/nconf": "^0.10.7",
    "@types/node": "^26.6.2",
    "@types/sinon": "^22.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^18.0.4",
    "github-action-readme-generator": "1.12.9",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.2",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@swc/core-darwin-x64": "^1.16.13"
  },
  "resolutions": {
    "minimist": "^1.2.8",
    "ansi-regex": "^6.1.0"
  },
  "packageManager": "yarn@1.22.22"
}
